// 'number' + 3 + 3 - відповідь:  'number33' 
//якщо є стрінга і + то число просто доєднується у рядок (конкатенація) 

// null + 3 - відповідь: 3
// null=0 при арифметичних операціях

// 5 && "qwerty" - відповідь: "qwerty"
// 5 - true та  "qwerty" - true. повертається останній true операнд  

// +'40' + +'2' + "hillel" - відповідь: "42hillel"
//'40' та '2' стали числами через +, та далі 42+"hillel" перетворилось у стрінгу

// '10' - 5 === 6; відповідь: false
//'10' - 5 дорівнює 5 ('10' стає числом), 5 не дорівнює 6

// true + false - відповідь: 1
// true=1 , false=0

//'4px' - 3 - відповідь: NaN
//неможливо від стрінги де є число разом із буквами та іншими символами відняти число, результатом буде не число

//'4' - 3 - відповідь: 1
//віднімання від стрінги дає число

//'6' + 3 ** 0 - відповідь: 61
//перша дія возводимо у степінь 3**0=1; друга - конкатенація '6'+1=61

// 12 / '6' - відповідь: 2
//'6' при поділі перетворилось на число

// '10' + (5 === 6); відповідь: '10false'
//5 === 6 буде false; '10' + false; при складанні зі стрингою false не стає числом

// null == '' -  відповідь: false
//null не перетворюється на 0 при порівнянні та може дорівнювати тілько до null чи undefined

// 3 ** (9 / 3) - відповідь: 27
//3**3=27; спочатку робимо те що в дужках

// !!'false' == !!'true' - відповідь: true
// 'false' і 'true' не пусті стрінги тому кожна з них це true, true == true це true

// 0 || '0' && 1 - відповідь: 1
// перша дія '0' && 1 - кожен операнд true тож поверне останній - це 1. 0 || 1 ,де 0 це false, тож поверне перший true операнд

// (+null == false) < 1; відповідь: false
// +null=0; false=0 звідси 0==0 це true; true=1; 1 не може бути більше 1

// false && true || true - відповідь: true
// false && true - поверне false (&& повертає true тільки якщо всі значення true); false || true - поверне перше true із можливих

// false && (false || true) -  відповідь: false
//перша дія в дужках (false || true) поверне true тощо || повернає перше true значення; отримуємо false && true; && повертає true тільки якщо всі значення true

// (+null == false) < 1 ** 5 - відповідь: false
//+null=0; false=0 звідси 0==0 це true; true=1; 1 ** 5=1; 1 не може бути більше 1